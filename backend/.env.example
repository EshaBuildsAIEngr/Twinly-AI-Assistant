# ===== DATABASE =====
# Neon.tech se milega — "Connection string" copy karo (Pooled connection wala)
DATABASE_URL=postgresql://user:password@host/dbname

# ===== AUTH =====
# Koi bhi random long string generate kar lo (terminal mein: openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== OPENAI =====
# platform.openai.com se milegi
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== WHATSAPP CLOUD API (Meta) =====
# developers.facebook.com -> App -> WhatsApp product se milega
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=twinly-webhook-verify-123

# ===== INSTAGRAM GRAPH API (Meta) =====
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=twinly-webhook-verify-123

# ===== APP =====
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
